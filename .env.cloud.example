# Cloud POC environment
LOGMONITOR_ENV=production

# Public domains
API_DOMAIN=api.example.com
DASHBOARD_DOMAIN=dashboard.example.com
GRAFANA_DOMAIN=grafana.example.com
CADDY_EMAIL=ops@example.com
GRAFANA_ROOT_URL=https://grafana.example.com

# App and operator secrets
FLASK_SECRET_KEY=replace_with_a_64_plus_char_random_secret
POSTGRES_DB=logmonitor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_db_password
GRAFANA_PASSWORD=replace_with_a_strong_grafana_password

# Demo users (change these for the cloud POC)
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASS=replace_with_a_strong_admin_password
DEMO_USER1_USER=user1
DEMO_USER1_PASS=replace_with_a_strong_user1_password
DEMO_USER2_USER=user2
DEMO_USER2_PASS=replace_with_a_strong_user2_password
DEMO_ANALYST_USER=analyst
DEMO_ANALYST_PASS=replace_with_a_strong_analyst_password

# Dashboard operator auth
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=replace_with_a_strong_dashboard_password
DASHBOARD_REFRESH_SECONDS=30

# Rate limiting
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_LOGIN=5 per minute
RATELIMIT_ADMIN=20 per minute
RATELIMIT_SEARCH=30 per minute
RATELIMIT_UPLOAD=10 per minute
RATELIMIT_FEEDBACK=20 per minute
MAX_UPLOAD_MB=5

# Runtime tuning for a constrained free-tier VM
INGESTER_LOG_FORMAT=json
INGESTER_BATCH_SIZE=100
INGESTER_POLL_INTERVAL=10
HYBRID_POLL_INTERVAL_SEC=2
HYBRID_FETCH_LIMIT=1000
RULE_ENGINE_INTERVAL_SEC=60
RULE_ENGINE_WINDOW=60 seconds
PROMETHEUS_RETENTION=7d
